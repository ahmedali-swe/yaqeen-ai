[{"id":"65004","title":"\u0627\u0644\u0637\u0647\u0648\u0631 \u0634\u0637\u0631 \u0627\u0644\u0625\u064a\u0645\u0627\u0646\u060c \u0648\u0627\u0644\u062d\u0645\u062f \u0644\u0644\u0647 \u062a\u0645\u0644\u0623 \u0627\u0644\u0645\u064a\u0632\u0627\u0646\u060c \u0648\u0633\u0628\u062d\u0627\u0646 \u0627\u0644\u0644\u0647 \u0648\u0627\u0644\u062d\u0645\u062f \u0644\u0644\u0647 \u062a\u0645\u0644\u0622\u0646 \u0623\u0648 \u062a\u0645\u0644\u0623 \u0645\u0627 \u0628\u064a\u0646 \u0627\u0644\u0633\u0645\u0627\u0648\u0627\u062a \u0648\u0627\u0644\u0623\u0631\u0636","hadith_text":"\u0639\u0646 \u0623\u0628\u064a \u0645\u0627\u0644\u0643\u064d \u0627\u0644\u0623\u0634\u0639\u0631\u064a\u0651\u0650 \u0631\u0636\u064a \u0627\u0644\u0644\u0647 \u0639\u0646\u0647 \u0642\u0627\u0644: \u0642\u0627\u0644 \u0631\u0633\u0648\u0644 \u0627\u0644\u0644\u0647 \u0635\u0644\u0649 \u0627\u0644\u0644\u0647 \u0639\u0644\u064a\u0647 \u0648\u0633\u0644\u0645:\u00ab\u0627\u0644\u0637\u0651\u064f\u0647\u064f\u0648\u0631\u064f \u0634\u064e\u0637\u0652\u0631\u064f \u0627\u0644\u0652\u0625\u0650\u064a\u0645\u064e\u0627\u0646\u0650\u060c \u0648\u064e\u0627\u0644\u0652\u062d\u064e\u0645\u0652\u062f\u064f \u0644\u0650\u0644\u0647\u0650 \u062a\u064e\u0645\u0652\u0644\u064e\u0623\u064f \u0627\u0644\u0652\u0645\u0650\u064a\u0632\u064e\u0627\u0646\u064e\u060c \u0648\u064e\u0633\u064f\u0628\u0652\u062d\u064e\u0627\u0646\u064e \u0627\u0644\u0644\u0647\u0650 \u0648\u064e\u0627\u0644\u0652\u062d\u064e\u0645\u0652\u062f\u064f \u0644\u0650\u0644\u0647\u0650 \u062a\u064e\u0645\u0652\u0644\u064e\u0622\u0646\u0650 -\u0623\u064e\u0648\u0652 \u062a\u064e\u0645\u0652\u0644\u064e\u0623\u064f- \u0645\u064e\u0627 \u0628\u064e\u064a\u0652\u0646\u064e \u0627\u0644\u0633\u0651\u064e\u0645\u064e\u0627\u0648\u064e\u0627\u062a\u0650 \u0648\u064e\u0627\u0644\u0652\u0623\u064e\u0631\u0652\u0636\u0650\u060c \u0648\u064e\u0627\u0644\u0635\u0651\u064e\u0644\u064e\u0627\u0629\u064f \u0646\u064f\u0648\u0631\u064c\u060c \u0648\u064e\u0627\u0644\u0635\u0651\u064e\u062f\u064e\u0642\u064e\u0629\u064f \u0628\u064f\u0631\u0652\u0647\u064e\u0627\u0646\u064c\u060c \u0648\u064e\u0627\u0644\u0635\u0651\u064e\u0628\u0652\u0631\u064f \u0636\u0650\u064a\u064e\u0627\u0621\u064c\u060c \u0648\u064e\u0627\u0644\u0652\u0642\u064f\u0631\u0652\u0622\u0646\u064f \u062d\u064f\u062c\u0651\u064e\u0629\u064c \u0644\u064e\u0643\u064e \u0623\u064e\u0648\u0652 \u0639\u064e\u0644\u064e\u064a\u0652\u0643\u064e\u060c \u0643\u064f\u0644\u0651\u064f \u0627\u0644\u0646\u0651\u064e\u0627\u0633\u0650 \u064a\u064e\u063a\u0652\u062f\u064f\u0648\u060c \u0641\u064e\u0628\u064e\u0627\u064a\u0650\u0639\u064c \u0646\u064e\u0641\u0652\u0633\u064e\u0647\u064f \u0641\u064e\u0645\u064f\u0639\u0652\u062a\u0650\u0642\u064f\u0647\u064e\u0627 \u0623\u064e\u0648\u0652 \u0645\u064f\u0648\u0628\u0650\u0642\u064f\u0647\u064e\u0627\u00bb.","hadith_text_highlights":"\u0639\u0646 \u0623\u0628\u064a \u0645\u0627\u0644\u0643\u064d \u0627\u0644\u0623\u0634\u0639\u0631\u064a\u0651\u0650 \u0631\u0636\u064a \u0627\u0644\u0644\u0647 \u0639\u0646\u0647 \u0642\u0627\u0644: \u0642\u0627\u0644 \u0631\u0633\u0648\u0644 \u0627\u0644\u0644\u0647 \u0635\u0644\u0649 \u0627\u0644\u0644\u0647 \u0639\u0644\u064a\u0647 \u0648\u0633\u0644\u0645:\u00ab<mark>\u0627\u0644\u0637\u0651\u064f\u0647\u064f\u0648\u0631\u064f<\/mark> <mark>\u0634\u064e\u0637\u0652\u0631\u064f<\/mark> <mark>\u0627\u0644\u0652\u0625\u0650\u064a\u0645\u064e\u0627\u0646\u0650<\/mark>\u060c \u0648\u064e\u0627\u0644\u0652\u062d\u064e\u0645\u0652\u062f\u064f \u0644\u0650\u0644\u0647\u0650 \u062a\u064e\u0645\u0652\u0644\u064e\u0623\u064f \u0627\u0644\u0652\u0645\u0650\u064a\u0632\u064e\u0627\u0646\u064e\u060c \u0648\u064e\u0633\u064f\u0628\u0652\u062d\u064e\u0627\u0646\u064e \u0627\u0644\u0644\u0647\u0650 \u0648\u064e\u0627\u0644\u0652\u062d\u064e\u0645\u0652\u062f\u064f \u0644\u0650\u0644\u0647\u0650 \u062a\u064e\u0645\u0652\u0644\u064e\u0622\u0646\u0650 -\u0623\u064e\u0648\u0652 \u062a\u064e\u0645\u0652\