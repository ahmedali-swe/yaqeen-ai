# Required for AI actions only; never NEXT_PUBLIC_* and never commit real keys.
AI_PROVIDER=groq
GROQ_API_KEY=
GROQ_TEXT_MODEL=openai/gpt-oss-120b
# Local demo evidence does not need live Dorar. Enable only for optional wider search.
DORAR_ENABLED=false
# Optional inactive extraction adapter; reasoning/Patch use Groq.
GEMINI_API_KEY=

# Render automatically enables trusted proxy origin validation via RENDER=true.
# For another proxy, enable only if ingress overwrites/appends forwarded host/proto
# and the app cannot be reached directly by clients. Keep unset for local dev.
# TRUST_PROXY=true

# OPTIONAL DATABASE TOOLS ONLY. Core submission runs without PostgreSQL or Docker.
# Local development only. Change this password outside local development.
POSTGRES_USER=yaqeen
POSTGRES_PASSWORD=yaqeen_local_only
POSTGRES_DB=yaqeen
POSTGRES_PORT=5432
# DATABASE_URL=postgresql://yaqeen:yaqeen_local_only@localhost:5432/yaqeen
# Optional: omit for localhost. Never put database credentials in NEXT_PUBLIC_*.
APP_URL=http://localhost:3000
DB_POOL_MAX=5
